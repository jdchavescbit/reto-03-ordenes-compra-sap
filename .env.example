# Proveedor de modelo de lenguaje: gemini | openai | anthropic | openrouter | ollama | local
# Si no se define ninguna API key, el agente usa automáticamente el motor determinista local (basado en herramientas)
LLM_PROVIDER=auto

# Google Gemini (recomendado: gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / Compatible (OpenRouter, LiteLLM, Azure, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama / Modelo local
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4-iq2:26b

# Límites de seguridad y costo (Sección 8 PRD)
PORT=3000
MAX_ITERATIONS_PER_TURN=25
MAX_TOKENS_PER_SESSION=100000
LLM_TIMEOUT_MS=30000
